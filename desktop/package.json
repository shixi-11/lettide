{
  "name": "lettide",
  "version": "0.3.2",
  "description": "Lettide — a calm home for your mail",
  "author": "Shixi Lin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "build": "electron-builder --win nsis",
    "build:release": "node ../scripts/Build-Desktop.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lettide.desktop",
    "productName": "Lettide",
    "directories": {
      "output": "../output/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/icon.png",
      "assets/icon.svg",
      "build-locale.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "src/**",
          "package.json"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!.modules.yaml",
          "!.package-map.json",
          "!.pnpm-workspace-state-v1.json",
          "!.pnpm/**",
          "!.bin/**"
        ]
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../docs/translation-model.md",
        "to": "docs/translation-model.md"
      },
      {
        "from": "../scripts/Configure-AI.ps1",
        "to": "scripts/Configure-AI.ps1"
      },
      {
        "from": "../scripts/Configure-AI.mjs",
        "to": "scripts/Configure-AI.mjs"
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "叠信",
      "artifactName": "Lettide-Setup-${version}.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "runAfterFinish": false
    },
    "executableName": "Lettide",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
